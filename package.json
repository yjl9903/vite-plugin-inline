{
  "name": "vite-plugin-inline",
  "version": "0.1.1",
  "description": "Inline raw TypeScript code as a string",
  "keywords": [
    "inline",
    "static-assets",
    "typescript",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/yjl9903/vite-plugin-inline#readme",
  "bugs": {
    "url": "https://github.com/yjl9903/vite-plugin-inline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjl9903/vite-plugin-inline.git"
  },
  "license": "MIT",
  "author": "XLor",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "files": [
    "dist",
    "*.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm -C examples/vite dev",
    "format": "prettier --write {src,test}/**/*.ts",
    "release": "bumpp --commit --push --tag",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "preversion": "pnpm typecheck && pnpm build",
    "postversion": "pnpm build"
  },
  "dependencies": {
    "get-tsconfig": "^4.14.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "bumpp": "^12.3.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
